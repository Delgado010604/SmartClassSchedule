<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SmartClass" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/icons</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/primary_text</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="App.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabTextColor">@color/secondary_text</item>
        <item name="tabSelectedTextColor">@color/primary_text</item>
    </style>
</resources>
