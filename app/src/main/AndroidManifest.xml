<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <application
        android:icon="@mipmap/ic_launcher_smartschedlogo"
        android:roundIcon="@mipmap/ic_launcher_smartschedlogo_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.SmartClass">

        <activity
            android:name=".DashboardActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".AddEditScheduleActivity"/>
        <activity android:name=".MainActivity"/>
        <activity android:name=".SettingsActivity"/>
        <activity android:name=".NotificationsActivity"/>
        <activity android:name=".TasksActivity"/>
        <activity android:name=".AddEditTaskActivity"/>

        <receiver
            android:name=".AlarmReceiver"
            android:enabled="true"
            android:exported="true" />

    </application>
</manifest>
